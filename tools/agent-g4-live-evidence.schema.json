{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plane-agent-g4/live-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "authorityId",
    "semanticDigest",
    "s00Gate",
    "providerRelay",
    "binding",
    "provider",
    "canaries",
    "thresholds",
    "readback",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": "plane-agent-g4/live-evidence/v1" },
    "status": { "const": "passed" },
    "authorityId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "semanticDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scenario": { "$ref": "#/$defs/scenario" },
    "s00Gate": { "$ref": "#/$defs/s00Gate" },
    "scenarioGate": { "$ref": "#/$defs/scenarioGate" },
    "commissionEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "run", "invocation", "providerAttempts", "scenarioGate", "routeEvidence", "replay"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
          "status": { "enum": ["passed", "failed"] },
          "run": { "type": "object" },
          "invocation": { "type": "object" },
          "providerAttempts": { "type": "array", "maxItems": 32 },
          "scenarioGate": { "$ref": "#/$defs/scenarioGate" },
          "routeEvidence": { "type": "object" },
          "replay": { "type": "object" }
        }
      }
    },
    "providerRelay": { "$ref": "#/$defs/providerRelay" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCommit",
        "g3Baseline",
        "hermesCommit",
        "mcpGitlink",
        "sdkGitlink",
        "runtimeImageTag",
        "runtimeImageDigest",
        "runtimeImageRevision",
        "runtimeContract",
        "apiArtifact"
      ],
      "properties": {
        "candidateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "g3Baseline": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "hermesCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "mcpGitlink": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sdkGitlink": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "runtimeImageTag": { "type": "string", "minLength": 1, "maxLength": 200 },
        "runtimeImageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "runtimeImageRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "runtimeContract": { "const": "plane.agent-runtime/v1" },
        "apiArtifact": { "$ref": "#/$defs/apiArtifact" }
      }
    },
    "provider": { "$ref": "#/$defs/provider" },
    "canaries": { "type": "object" },
    "thresholds": { "type": "object" },
    "readback": {
      "type": "object",
      "required": [
        "audit",
        "version",
        "runtimeExit",
        "runtimeEventIngress",
        "providerAttempts",
        "planeOperationAudit",
        "transcriptEvidence",
        "explicitPublication",
        "replay"
      ],
      "properties": {
        "transcriptEvidence": { "$ref": "#/$defs/transcriptEvidence" }
      }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "apiArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageTag", "imageDigest", "sourceRevision", "contract"],
      "properties": {
        "imageTag": { "type": "string", "minLength": 1, "maxLength": 200 },
        "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contract": { "const": "plane.operation/v1" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model",
        "baseUrl",
        "host",
        "path",
        "credentialSource",
        "credentialRef",
        "credentialName",
        "fallbackUsed"
      ],
      "properties": {
        "name": { "const": "openai-codex" },
        "model": { "const": "gpt-5.6-luna" },
        "baseUrl": { "const": "https://chatgpt.com/backend-api/codex/responses" },
        "host": { "const": "chatgpt.com" },
        "path": { "const": "/backend-api/codex/responses" },
        "credentialSource": { "const": "chatgpt-subscription" },
        "credentialRef": { "const": "PLANE_G4_PROVIDER_SECRET_SOURCE" },
        "credentialName": { "const": "api_key" },
        "fallbackUsed": { "const": false }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "descriptorDigest", "schemaVersion", "actorRole", "profileName"],
      "properties": {
        "id": { "enum": ["worker", "manager", "operator"] },
        "descriptorDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "schemaVersion": { "const": "plane.agent-scenario/v1" },
        "actorRole": { "enum": ["worker", "delegator"] },
        "profileName": { "type": "string", "minLength": 1, "maxLength": 96 },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationOutcomes", "evidenceKinds"],
          "properties": {
            "operationOutcomes": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operationId", "outcome"],
                "properties": {
                  "operationId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{0,127}$" },
                  "outcome": { "enum": ["success", "denied", "not_observed"] },
                  "count": { "type": "integer", "minimum": 0, "maximum": 256 }
                }
              }
            },
            "evidenceKinds": {
              "type": "array",
              "maxItems": 16,
              "items": { "enum": ["assignment", "run", "invocation", "input_event", "audit", "publication", "terminal_event", "schedule", "schedule_fire", "lineage_assignment"] }
            },
            "durableRecords": { "$ref": "#/$defs/durableCountRows" },
            "productEvents": { "$ref": "#/$defs/productCountRows" },
            "routeChecks": { "type": "array", "uniqueItems": true, "maxItems": 9, "items": { "enum": ["W01", "W02", "W03", "W04", "W05", "W06", "W07", "W08", "O01", "O03", "O04", "O05", "O06", "O07", "O08", "O09", "O10", "M01", "M02", "M03", "M04", "M05", "M06", "M07", "M08"] } }
          }
        },
        "setup": { "$ref": "#/$defs/setup" },
        "controls": { "$ref": "#/$defs/controls" },
        "actual": { "$ref": "#/$defs/scenarioActual" }
      }
    },
    "setup": {
      "type": "object", "additionalProperties": false, "required": ["preconditions", "actors"],
      "properties": {
        "preconditions": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "actors": { "type": "array", "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["ref", "role", "displayName"], "properties": { "ref": { "type": "string" }, "role": { "type": "string" }, "displayName": { "type": "string" } } } },
        "lineage": { "type": "object", "additionalProperties": false, "required": ["parentActorRef", "childActorRef", "scopeRefs", "budget"], "properties": { "parentActorRef": { "type": "string" }, "childActorRef": { "type": "string" }, "scopeRefs": { "type": "array" }, "budget": { "type": "integer", "minimum": 0 } } },
        "schedule": { "type": "object", "additionalProperties": false, "required": ["actorRef", "cron", "timezone", "startsAt", "fireAt"], "properties": { "actorRef": { "type": "string" }, "cron": { "type": "string" }, "timezone": { "type": "string" }, "startsAt": { "type": "string" }, "fireAt": { "type": ["string", "null"] } } }
      }
    },
    "controls": { "type": "object", "additionalProperties": false, "required": ["fault"], "properties": { "fault": { "type": "object", "additionalProperties": false, "required": ["selection"], "properties": { "selection": { "enum": ["none", "budget_exhausted", "runtime_unavailable"] } } }, "continuation": { "type": "object" }, "revision": { "type": "object" }, "cancellation": { "type": "object" } } },
    "durableCountRows": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "count"], "properties": { "kind": { "enum": ["assignment", "run", "invocation", "input_event", "audit", "publication", "terminal_event", "schedule", "schedule_fire", "lineage_assignment"] }, "count": { "type": "integer", "minimum": 0, "maximum": 256 } } } },
    "productCountRows": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "count"], "properties": { "kind": { "enum": ["publication", "outcome_submission", "run_failure", "run_blocker", "run_cancellation", "input_event"] }, "count": { "type": "integer", "minimum": 0, "maximum": 256 } } } },
    "scenarioGate": { "type": "object", "additionalProperties": false, "required": ["passed", "failures", "operations", "durableRecords", "productEvents", "evidenceKinds"], "properties": { "passed": { "type": "boolean" }, "failures": { "type": "array" }, "operations": { "type": "array" }, "durableRecords": { "type": "array" }, "productEvents": { "type": "array" }, "evidenceKinds": { "type": "array" } } },
    "scenarioActual": { "type": "object", "additionalProperties": false, "required": ["operations", "records", "productEvents", "evidenceKinds"], "properties": { "operations": { "type": "array" }, "records": { "type": "array" }, "productEvents": { "type": "array" }, "evidenceKinds": { "type": "array" }, "routeEvidence": { "type": "object" } } },
    "providerRelay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "transport",
        "childNetworkPolicy",
        "externalEgressOwner",
        "hostGatewaySeparate",
        "hermesHookStatus"
      ],
      "properties": {
        "protocol": { "const": "plane.agent-runtime/provider-relay/v1" },
        "transport": { "const": "AF_UNIX" },
        "childNetworkPolicy": { "const": "none" },
        "externalEgressOwner": { "const": "agent-runtime" },
        "hostGatewaySeparate": { "const": true },
        "hermesHookStatus": { "enum": ["pending", "integrated"] }
      }
    },
    "transcriptEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requirement", "count", "eventIds"],
      "properties": {
        "status": { "enum": ["observed", "not_observed"] },
        "requirement": { "enum": ["required", "not_required"] },
        "count": { "type": "integer", "minimum": 0, "maximum": 32 },
        "eventIds": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^event:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$" }
        }
      }
    },
    "s00Gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "firstFailedPredicate", "predicates"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "firstFailedPredicate": { "type": ["string", "null"] },
        "predicates": { "type": "object", "additionalProperties": true }
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "durationMs", "migrationLeaf", "workload"],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "passed", "failed", "skipped", "xfail", "deselected"],
          "properties": {
            "collected": { "$ref": "#/$defs/count" },
            "passed": { "$ref": "#/$defs/count" },
            "failed": { "$ref": "#/$defs/count" },
            "skipped": { "$ref": "#/$defs/count" },
            "xfail": { "$ref": "#/$defs/count" },
            "deselected": { "$ref": "#/$defs/count" }
          }
        },
        "durationMs": { "type": "number", "minimum": 0 },
        "migrationLeaf": { "type": "string", "minLength": 1, "maxLength": 100 },
        "workload": { "type": "object" }
      }
    }
  }
}
