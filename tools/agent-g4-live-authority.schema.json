{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plane-agent-g4/live-authority/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityId",
    "purpose",
    "issuedAt",
    "expiresAt",
    "expectedCandidate",
    "binding",
    "fallbackAllowed"
  ],
  "properties": {
    "schemaVersion": { "const": "plane-agent-g4/live-authority/v1" },
    "authorityId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "purpose": { "const": "g4-live-evaluation" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "expectedCandidate": { "$ref": "#/$defs/sha" },
    "fallbackAllowed": { "const": false },
    "providerRelay": { "$ref": "#/$defs/providerRelay" },
    "binding": { "$ref": "#/$defs/binding" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "providerRelay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "transport",
        "childNetworkPolicy",
        "externalEgressOwner",
        "hostGatewaySeparate",
        "hermesHookStatus"
      ],
      "properties": {
        "protocol": { "const": "plane.agent-runtime/provider-relay/v1" },
        "transport": { "const": "AF_UNIX" },
        "childNetworkPolicy": { "const": "none" },
        "externalEgressOwner": { "const": "agent-runtime" },
        "hostGatewaySeparate": { "const": true },
        "hermesHookStatus": { "enum": ["pending", "integrated"] }
      }
    },
    "apiArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageTag", "imageDigest", "sourceRevision", "contract"],
      "properties": {
        "imageTag": { "type": "string", "minLength": 1, "maxLength": 200 },
        "imageDigest": { "$ref": "#/$defs/digest" },
        "sourceRevision": { "$ref": "#/$defs/sha" },
        "contract": { "const": "plane.operation/v1" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCommit",
        "g3Baseline",
        "hermesCommit",
        "mcpGitlink",
        "sdkGitlink",
        "runtimeImageTag",
        "runtimeImageDigest",
        "runtimeImageRevision",
        "runtimeContract",
        "apiArtifact",
        "commandSha256",
        "provider",
        "thresholdProfile",
        "thresholds",
        "canaries"
      ],
      "properties": {
        "candidateCommit": { "$ref": "#/$defs/sha" },
        "g3Baseline": { "$ref": "#/$defs/sha" },
        "hermesCommit": { "$ref": "#/$defs/sha" },
        "mcpGitlink": { "$ref": "#/$defs/sha" },
        "sdkGitlink": { "$ref": "#/$defs/sha" },
        "runtimeImageTag": { "type": "string", "minLength": 1, "maxLength": 200 },
        "runtimeImageDigest": { "$ref": "#/$defs/digest" },
        "runtimeImageRevision": { "$ref": "#/$defs/sha" },
        "runtimeContract": { "type": "string", "const": "plane.agent-runtime/v1" },
        "apiArtifact": { "$ref": "#/$defs/apiArtifact" },
        "commandSha256": { "$ref": "#/$defs/hash" },
        "provider": { "$ref": "#/$defs/providerDescriptor" },
        "thresholdProfile": { "type": "string", "minLength": 1, "maxLength": 200 },
        "thresholds": { "$ref": "#/$defs/thresholds" },
        "canaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["permitted", "denied"],
          "properties": {
            "permitted": { "$ref": "#/$defs/canary" },
            "denied": { "$ref": "#/$defs/canary" }
          }
        }
      }
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expectedStatus"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
        "expectedStatus": { "enum": ["allowed", "denied"] }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permittedSuccessRateMin", "deniedRejectionRateMin", "maxLatencyP95Ms", "maxErrorRate"],
      "properties": {
        "permittedSuccessRateMin": { "type": "number", "minimum": 0, "maximum": 1 },
        "deniedRejectionRateMin": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxLatencyP95Ms": { "type": "number", "minimum": 0 },
        "maxErrorRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "providerDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "baseUrl", "host", "path", "credentialSource", "credentialRef", "credentialName"],
      "properties": {
        "name": { "const": "openai-codex" },
        "model": { "const": "gpt-5.6-luna" },
        "baseUrl": { "const": "https://chatgpt.com/backend-api/codex/responses" },
        "host": { "const": "chatgpt.com" },
        "path": { "const": "/backend-api/codex/responses" },
        "credentialSource": { "const": "chatgpt-subscription" },
        "credentialRef": { "const": "PLANE_G4_PROVIDER_SECRET_SOURCE" },
        "credentialName": { "const": "api_key" }
      }
    }
  }
}
