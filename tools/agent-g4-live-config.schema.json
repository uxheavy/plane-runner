{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plane-agent-g4/live-config/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityId",
    "mode",
    "offline",
    "fallbackAllowed",
    "expectedCandidate",
    "providerRelay",
    "binding",
    "provider",
    "thresholdProfile",
    "thresholds",
    "canaries",
    "requiredReadbacks"
  ],
  "properties": {
    "schemaVersion": { "const": "plane-agent-g4/live-config/v1" },
    "authorityId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "mode": { "const": "live" },
    "offline": { "const": false },
    "fallbackAllowed": { "const": false },
    "expectedCandidate": { "$ref": "#/$defs/sha" },
    "providerRelay": { "$ref": "#/$defs/providerRelay" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCommit",
        "g3Baseline",
        "hermesCommit",
        "mcpGitlink",
        "sdkGitlink",
        "runtimeImageTag",
        "runtimeImageDigest",
        "runtimeImageRevision",
        "runtimeContract",
        "apiArtifact",
        "commandSha256",
        "provider",
        "thresholdProfile",
        "thresholds",
        "canaries"
      ],
      "properties": {
        "candidateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "g3Baseline": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "hermesCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "mcpGitlink": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sdkGitlink": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "runtimeImageTag": { "type": "string", "minLength": 1, "maxLength": 200 },
        "runtimeImageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "runtimeImageRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "runtimeContract": { "const": "plane.agent-runtime/v1" },
        "apiArtifact": { "$ref": "#/$defs/apiArtifact" },
        "commandSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "provider": { "$ref": "#/$defs/provider" },
        "thresholdProfile": { "type": "string" },
        "thresholds": { "type": "object" },
        "canaries": { "type": "object" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model",
        "baseUrl",
        "host",
        "path",
        "credentialSource",
        "credentialRef",
        "credentialName",
        "fallbackUsed"
      ],
      "properties": {
        "name": { "const": "openai-codex" },
        "model": { "const": "gpt-5.6-luna" },
        "baseUrl": { "const": "https://chatgpt.com/backend-api/codex/responses" },
        "host": { "const": "chatgpt.com" },
        "path": { "const": "/backend-api/codex/responses" },
        "credentialSource": { "const": "chatgpt-subscription" },
        "credentialRef": { "const": "PLANE_G4_PROVIDER_SECRET_SOURCE" },
        "credentialName": { "const": "api_key" },
        "fallbackUsed": { "const": false }
      }
    },
    "thresholdProfile": { "type": "string", "minLength": 1, "maxLength": 200 },
    "thresholds": { "type": "object" },
    "canaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permitted", "denied"],
      "properties": {
        "permitted": { "type": "string", "minLength": 1, "maxLength": 200 },
        "denied": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "requiredReadbacks": {
      "type": "array",
      "const": ["audit", "version"]
    },
    "fallbackProviders": {
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "apiArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageTag", "imageDigest", "sourceRevision", "contract"],
      "properties": {
        "imageTag": { "type": "string", "minLength": 1, "maxLength": 200 },
        "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contract": { "const": "plane.operation/v1" }
      }
    },
    "providerRelay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "transport",
        "childNetworkPolicy",
        "externalEgressOwner",
        "hostGatewaySeparate",
        "hermesHookStatus"
      ],
      "properties": {
        "protocol": { "const": "plane.agent-runtime/provider-relay/v1" },
        "transport": { "const": "AF_UNIX" },
        "childNetworkPolicy": { "const": "none" },
        "externalEgressOwner": { "const": "agent-runtime" },
        "hostGatewaySeparate": { "const": true },
        "hermesHookStatus": { "enum": ["pending", "integrated"] }
      }
    }
  }
}
