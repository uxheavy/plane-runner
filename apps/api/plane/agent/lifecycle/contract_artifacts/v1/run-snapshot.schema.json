{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plane.dev/schemas/plane.agent-runtime/v1/RunSnapshot.schema.json",
  "title": "RunSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "workspaceRef",
    "runId",
    "assignment",
    "actorRef",
    "profile",
    "context",
    "toolCatalog",
    "runtimePolicy",
    "totalBudget",
    "contractDigests",
    "contentDigest"
  ],
  "properties": {
    "protocol": {
      "const": "plane.agent-runtime/v1"
    },
    "workspaceRef": {
      "$ref": "#/$defs/workspaceRef"
    },
    "runId": {
      "$ref": "#/$defs/runId"
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignmentRef", "revision", "targetRef", "objective", "acceptanceCriteria"],
      "properties": {
        "assignmentRef": {
          "$ref": "#/$defs/assignmentRef"
        },
        "revision": {
          "$ref": "#/$defs/boundedToken"
        },
        "targetRef": {
          "$ref": "#/$defs/targetRef"
        },
        "objective": {
          "$ref": "#/$defs/boundedText"
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/boundedText"
          }
        }
      }
    },
    "actorRef": {
      "$ref": "#/$defs/actorRef"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileRef", "revision", "role", "behavioralPrompt"],
      "properties": {
        "profileRef": {
          "$ref": "#/$defs/profileVersionRef"
        },
        "revision": {
          "$ref": "#/$defs/boundedToken"
        },
        "role": {
          "enum": ["worker", "delegator", "gardener", "chief_of_staff", "hr", "evaluator", "custom"]
        },
        "behavioralPrompt": {
          "$ref": "#/$defs/boundedPrompt"
        }
      }
    },
    "context": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contextRef", "revision", "contentDigest"],
        "properties": {
          "contextRef": {
            "$ref": "#/$defs/contextRef"
          },
          "revision": {
            "$ref": "#/$defs/boundedToken"
          },
          "contentDigest": {
            "$ref": "#/$defs/contentDigest"
          }
        }
      }
    },
    "toolCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogDigest", "eagerOperations"],
      "properties": {
        "catalogDigest": {
          "$ref": "#/$defs/contentDigest"
        },
        "eagerOperations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operationRef", "schemaDigest", "disclosure"],
            "properties": {
              "operationRef": {
                "$ref": "#/$defs/operationRef"
              },
              "schemaDigest": {
                "$ref": "#/$defs/contentDigest"
              },
              "disclosure": {
                "enum": ["eager", "progressive"]
              }
            }
          }
        }
      }
    },
    "runtimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "adapter", "isolation", "maxEventPayloadBytes", "maxArtifactBytes", "maxReceiptBytes"],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model"],
          "properties": {
            "provider": {
              "$ref": "#/$defs/boundedToken"
            },
            "model": {
              "$ref": "#/$defs/boundedToken"
            }
          }
        },
        "adapter": {
          "$ref": "#/$defs/boundedToken"
        },
        "isolation": {
          "const": "single-invocation"
        },
        "maxEventPayloadBytes": {
          "$ref": "#/$defs/boundedByteCount"
        },
        "maxArtifactBytes": {
          "$ref": "#/$defs/boundedByteCount"
        },
        "maxReceiptBytes": {
          "$ref": "#/$defs/boundedByteCount"
        }
      }
    },
    "totalBudget": {
      "$ref": "#/$defs/runtimeBudget"
    },
    "contractDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runSnapshot", "invocationEnvelope", "runtimeEvent", "runtimeExit", "runtimeDurableState"],
      "properties": {
        "runSnapshot": {
          "$ref": "#/$defs/contractDigest"
        },
        "invocationEnvelope": {
          "$ref": "#/$defs/contractDigest"
        },
        "runtimeEvent": {
          "$ref": "#/$defs/contractDigest"
        },
        "runtimeExit": {
          "$ref": "#/$defs/contractDigest"
        },
        "runtimeDurableState": {
          "$ref": "#/$defs/contractDigest"
        }
      }
    },
    "contentDigest": {
      "$ref": "#/$defs/runSnapshotContentDigest"
    }
  },
  "$defs": {
    "actorRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^actor:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "assignmentRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^assignment:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "boundedByteCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "boundedPrompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "x-utf8ByteMax": 32768
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-utf8ByteMax": 4096
    },
    "boundedToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-utf8ByteMax": 256
    },
    "contentDigest": {
      "type": "string",
      "minLength": 72,
      "maxLength": 72,
      "x-utf8ByteMax": 72,
      "pattern": "^content:[a-f0-9]{64}$"
    },
    "contextRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^context:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "contractDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "x-utf8ByteMax": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "operationRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^operation:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "profileVersionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^profile-version:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^run:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "runSnapshotContentDigest": {
      "type": "string",
      "minLength": 73,
      "maxLength": 73,
      "x-utf8ByteMax": 73,
      "pattern": "^snapshot:[a-f0-9]{64}$"
    },
    "runtimeBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "durationMs"],
      "properties": {
        "inputTokens": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "outputTokens": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "durationMs": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "targetRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^target:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "workspaceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^workspace:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    }
  }
}
