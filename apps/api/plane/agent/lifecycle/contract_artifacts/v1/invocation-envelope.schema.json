{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plane.dev/schemas/plane.agent-runtime/v1/InvocationEnvelope.schema.json",
  "title": "InvocationEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "workspaceRef",
    "actorRef",
    "runId",
    "invocationId",
    "runSnapshotDigest",
    "trigger",
    "newContextEventRefs",
    "remainingBudget",
    "lease",
    "cancellationRef",
    "causationRef",
    "correlationId",
    "idempotencyKey"
  ],
  "properties": {
    "protocol": {
      "const": "plane.agent-runtime/v1"
    },
    "workspaceRef": {
      "$ref": "#/$defs/workspaceRef"
    },
    "actorRef": {
      "$ref": "#/$defs/actorRef"
    },
    "runId": {
      "$ref": "#/$defs/runId"
    },
    "invocationId": {
      "$ref": "#/$defs/invocationId"
    },
    "runSnapshotDigest": {
      "$ref": "#/$defs/runSnapshotContentDigest"
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "initial"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "human_input"
            },
            "eventRef": {
              "$ref": "#/$defs/eventRef"
            },
            "pendingInputEventRef": {
              "$ref": "#/$defs/eventRef"
            },
            "answerFactDigest": {
              "$ref": "#/$defs/contentDigest"
            }
          },
          "required": ["kind", "eventRef", "pendingInputEventRef", "answerFactDigest"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "eventRef"],
          "properties": {
            "kind": {
              "enum": ["recoverable_restart", "continuation"]
            },
            "eventRef": {
              "$ref": "#/$defs/eventRef"
            },
            "pendingInputEventRef": {
              "$ref": "#/$defs/eventRef"
            }
          }
        }
      ]
    },
    "newContextEventRefs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/eventRef"
      }
    },
    "checkpointRef": {
      "$ref": "#/$defs/checkpointRef"
    },
    "remainingBudget": {
      "$ref": "#/$defs/runtimeBudget"
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaseId", "expiresAt", "renewAfterMs"],
      "properties": {
        "leaseId": {
          "$ref": "#/$defs/leaseId"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "renewAfterMs": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "cancellationRef": {
      "$ref": "#/$defs/cancellationRef"
    },
    "causationRef": {
      "$ref": "#/$defs/causationRef"
    },
    "correlationId": {
      "$ref": "#/$defs/correlationId"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/idempotencyKey"
    }
  },
  "$defs": {
    "actorRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^actor:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "cancellationRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^cancellation:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "causationRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^causation:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "checkpointRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^checkpoint:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "contentDigest": {
      "type": "string",
      "minLength": 72,
      "maxLength": 72,
      "x-utf8ByteMax": 72,
      "pattern": "^content:[a-f0-9]{64}$"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^correlation:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "eventRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^event:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^idempotency:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "invocationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^invocation:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "leaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^lease:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^run:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    },
    "runSnapshotContentDigest": {
      "type": "string",
      "minLength": 73,
      "maxLength": 73,
      "x-utf8ByteMax": 73,
      "pattern": "^snapshot:[a-f0-9]{64}$"
    },
    "runtimeBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "durationMs"],
      "properties": {
        "inputTokens": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "outputTokens": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "durationMs": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-utf8ByteMax": 64
    },
    "workspaceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-utf8ByteMax": 128,
      "pattern": "^workspace:[A-Za-z0-9][A-Za-z0-9._~/-]{0,119}$"
    }
  }
}
