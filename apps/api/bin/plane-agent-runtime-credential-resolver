#!/usr/local/bin/python3
"""Entrypoint for the deployment-owned Plane runtime credential resolver."""

from __future__ import annotations

import json
import sys

# The G4 artifact keeps the prepared base's stale development tree at /code,
# so always import the source copied into this image's candidate root.
sys.path.insert(0, "/workspace/apps/api")

def main() -> int:
    if len(sys.argv) != 2:
        return 64
    try:
        from plane.agent.runtime.credentials import resolve_deployment_credential

        credentials = resolve_deployment_credential(sys.argv[1])
    except Exception:
        return 78
    json.dump(credentials, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0


raise SystemExit(main())
