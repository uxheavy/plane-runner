#!/usr/local/bin/python3
"""Entrypoint for the deployment-owned Plane runtime credential resolver."""

from __future__ import annotations

import importlib.util
import json
import sys
import types
from pathlib import Path

# The G4 artifact keeps the prepared base's stale development tree at /code,
# so always load the pure-stdlib parser copied into this image's candidate root.
# Importing the Plane package would eagerly initialize Django/Celery and require
# the host API environment that this deliberately minimal resolver child does
# not receive.
_CREDENTIALS_SOURCE = "/usr/local/lib/plane-agent-runtime/credentials.py"


def _credentials_source_candidates() -> tuple[Path, ...]:
    # The G4 artifact owns the canonical /workspace path. The regular API
    # images install this launcher under /usr/local/bin while keeping the
    # source tree at /code, so derive that layout from the launcher instead of
    # relying on the caller's working directory.
    launcher_root = Path(__file__).resolve().parent.parent
    return (
        Path(_CREDENTIALS_SOURCE),
        Path("/workspace/apps/api/plane/agent/runtime/credentials.py"),
        Path("/code/plane/agent/runtime/credentials.py"),
        launcher_root / "plane/agent/runtime/credentials.py",
    )


def _load_credentials_module():
    candidates = _credentials_source_candidates()
    source = next((path for path in candidates if path.is_file()), None)
    if source is None:
        raise RuntimeError("deployment credential parser is unavailable")
    package_name = "_plane_runtime_credentials"
    package_paths = [
        str(path.parent)
        for path in candidates
        if (path.parent / "contracts.py").is_file()
    ]
    if not package_paths:
        raise RuntimeError("deployment credential parser dependencies are unavailable")
    package = types.ModuleType(package_name)
    package.__path__ = package_paths
    sys.modules[package_name] = package
    spec = importlib.util.spec_from_file_location(f"{package_name}.credentials", source)
    if spec is None or spec.loader is None:
        raise RuntimeError("deployment credential parser is unavailable")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def main() -> int:
    if len(sys.argv) != 2:
        return 64
    try:
        credentials = _load_credentials_module().resolve_deployment_credential(sys.argv[1])
    except Exception:
        return 78
    json.dump(credentials, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
