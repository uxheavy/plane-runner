{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plane.so/schemas/agent-tooling/qualification-result-v1.schema.json",
  "title": "Plane Safety Trial Independent Qualification Result v1",
  "description": "The independent verifier's terminal recomputation record with closed qualification outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "qualification_id",
    "trial_binding",
    "verification_binding",
    "verifier_identity",
    "started_at",
    "completed_at",
    "acquired_evidence",
    "predicate_results",
    "mutation_coverage",
    "integrity_checks",
    "outcome",
    "summary",
    "verifier_attestation"
  ],
  "properties": {
    "schema": { "const": "plane.agent.safety-qualification-result/v1" },
    "schema_version": { "const": 1 },
    "qualification_id": { "$ref": "#/$defs/uuid" },
    "trial_binding": { "$ref": "#/$defs/trialBinding" },
    "verification_binding": { "$ref": "#/$defs/verificationBinding" },
    "verifier_identity": { "$ref": "#/$defs/verifierIdentity" },
    "started_at": { "$ref": "#/$defs/dateTime" },
    "completed_at": { "$ref": "#/$defs/dateTime" },
    "acquired_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/acquiredEvidence" }
    },
    "predicate_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/predicateResult" }
    },
    "mutation_coverage": {
      "type": "array",
      "description": "Only mutation cases applicable to this trial's bound predicates. Bundle-wide coverage of all mutation classes is validated by the bundle/control qualification, not by an individual trial result.",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/mutationCoverage" }
    },
    "integrity_checks": { "$ref": "#/$defs/integrityChecks" },
    "outcome": { "enum": ["qualified", "not_qualified"] },
    "summary": { "$ref": "#/$defs/summary" },
    "verifier_attestation": { "$ref": "#/$defs/verifierAttestation" }
  },
  "allOf": [
    {
      "if": { "type": "object", "required": ["outcome"], "properties": { "outcome": { "const": "qualified" } } },
      "then": {
        "type": "object",
        "properties": {
          "predicate_results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "outcome": { "const": "satisfied" },
                "negative_controls": {
                  "type": "array",
                  "items": { "type": "object", "properties": { "outcome": { "const": "detected" } } }
                }
              }
            }
          },
          "mutation_coverage": {
            "type": "array",
            "items": { "type": "object", "properties": { "outcome": { "const": "detected" } } }
          },
          "summary": {
            "type": "object",
            "properties": {
              "not_satisfied_count": { "const": 0 },
              "not_detected_mutation_count": { "const": 0 }
            }
          },
          "integrity_checks": {
            "type": "object",
            "properties": {
              "semantic_id_uniqueness": { "const": "verified" },
              "referential_closure": { "const": "verified" },
              "evidence_trial_run_nonce_correlation": { "const": "verified" }
            }
          }
        }
      }
    },
    {
      "if": { "type": "object", "required": ["outcome"], "properties": { "outcome": { "const": "not_qualified" } } },
      "then": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "predicate_results": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": ["outcome"],
                  "properties": { "outcome": { "const": "not_satisfied" } }
                },
                "minContains": 1
              },
              "summary": {
                "type": "object",
                "properties": { "not_satisfied_count": { "type": "integer", "minimum": 1 } }
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "mutation_coverage": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": ["outcome"],
                  "properties": { "outcome": { "const": "not_detected" } }
                },
                "minContains": 1
              },
              "summary": {
                "type": "object",
                "properties": { "not_detected_mutation_count": { "type": "integer", "minimum": 1 } }
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "predicate_results": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": ["negative_controls"],
                  "properties": {
                    "negative_controls": {
                      "type": "array",
                      "contains": {
                        "type": "object",
                        "required": ["outcome"],
                        "properties": { "outcome": { "const": "not_detected" } }
                      },
                      "minContains": 1
                    }
                  }
                },
                "minContains": 1
              },
              "summary": {
                "type": "object",
                "properties": { "not_detected_mutation_count": { "type": "integer", "minimum": 1 } }
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "integrity_checks": {
                "type": "object",
                "anyOf": [
                  { "properties": { "semantic_id_uniqueness": { "const": "failed" } } },
                  { "properties": { "referential_closure": { "const": "failed" } } },
                  { "properties": { "evidence_trial_run_nonce_correlation": { "const": "failed" } } }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36 },
    "dateTime": { "type": "string", "format": "date-time", "minLength": 20, "maxLength": 35 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": { "type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]{86}$" },
    "boundedIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "boundedRole": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "evidenceRole": {
      "enum": [
        "plane_object_snapshot",
        "plane_invocation_snapshot",
        "plane_activity_snapshot",
        "broker_publication_snapshot",
        "plane_audit_readback",
        "edge_authentication_readback",
        "host_security_readback",
        "gateway_envelope",
        "http_metadata",
        "infrastructure_attempt_readback",
        "fault_barrier_acknowledgement",
        "fault_injection_trace",
        "transport_trace",
        "canary_reachability",
        "canary_hit_counts",
        "listener_trace",
        "container_death",
        "isolate_exit",
        "supervisor_heartbeat",
        "process_trace",
        "isolate_trace",
        "callback_trace",
        "transcript",
        "tool_call_trace",
        "generated_typescript",
        "final_response",
        "structural_inventory",
        "cleanup",
        "retained_attempt_ledger",
        "predicate_recomputation"
      ]
    },
    "jsonPointer": { "type": "string", "maxLength": 1024, "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$" },
    "trialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_id", "run_id", "evidence_nonce", "fixture_id", "scenario_id", "trial_result_sha256"],
      "properties": {
        "trial_id": { "$ref": "#/$defs/uuid" },
        "run_id": { "$ref": "#/$defs/uuid" },
        "evidence_nonce": { "$ref": "#/$defs/uuid" },
        "fixture_id": { "type": "string", "pattern": "^FX-SAFE-0(1[1-9]|2[0-9]|30)$" },
        "scenario_id": { "type": "string", "pattern": "^EV-0(1[1-9]|2[0-9]|30)$" },
        "trial_result_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "verificationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_manifest_version",
        "release_manifest_sha256",
        "verification_manifest_version",
        "verification_manifest_sha256",
        "fixture_sha256",
        "predicate_bundle_sha256",
        "operator_bundle_sha256",
        "qualification_build_sha256"
      ],
      "properties": {
        "release_manifest_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "release_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "verification_manifest_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "verification_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "fixture_sha256": { "$ref": "#/$defs/sha256" },
        "predicate_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "operator_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "qualification_build_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "verifierIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "process_identity", "key_id", "independent_from_producer_principals"],
      "properties": {
        "principal_id": { "$ref": "#/$defs/boundedIdentity" },
        "process_identity": { "$ref": "#/$defs/boundedIdentity" },
        "key_id": { "$ref": "#/$defs/boundedIdentity" },
        "independent_from_producer_principals": { "const": true }
      }
    },
    "acquiredEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "role",
        "producer_principal",
        "producer_process_identity",
        "peer_identity",
        "source_channel_id",
        "acquisition_receipt_sha256"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/uuid" },
        "role": { "$ref": "#/$defs/evidenceRole" },
        "producer_principal": { "$ref": "#/$defs/boundedIdentity" },
        "producer_process_identity": { "$ref": "#/$defs/boundedIdentity" },
        "peer_identity": { "$ref": "#/$defs/boundedIdentity" },
        "source_channel_id": { "$ref": "#/$defs/boundedIdentity" },
        "acquisition_receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "role", "json_pointers"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/uuid" },
        "role": { "$ref": "#/$defs/evidenceRole" },
        "json_pointers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPointer" }
        }
      }
    },
    "negativeControlResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_id", "mutation_class", "outcome", "diagnostic_code"],
      "properties": {
        "mutation_id": { "$ref": "#/$defs/boundedIdentity" },
        "mutation_class": { "$ref": "#/$defs/mutationClass" },
        "outcome": { "enum": ["detected", "not_detected"] },
        "diagnostic_code": { "$ref": "#/$defs/boundedRole" }
      }
    },
    "predicateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate_id",
        "operator_id",
        "operator_sha256",
        "oracle_source",
        "arguments_schema_sha256",
        "arguments_sha256",
        "evidence_inputs",
        "negative_controls",
        "outcome",
        "diagnostic_codes"
      ],
      "properties": {
        "predicate_id": { "$ref": "#/$defs/boundedIdentity" },
        "operator_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 192,
          "pattern": "^[a-z][a-z0-9_.-]*@[1-9][0-9]*$"
        },
        "operator_sha256": { "$ref": "#/$defs/sha256" },
        "oracle_source": {
          "enum": ["derived_from_seed", "derived_from_contract", "derived_from_fault_trace", "exact_constant"]
        },
        "arguments_schema_sha256": { "$ref": "#/$defs/sha256" },
        "arguments_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceInput" }
        },
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/negativeControlResult" }
        },
        "outcome": { "enum": ["satisfied", "not_satisfied"] },
        "diagnostic_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/boundedRole" }
        }
      }
    },
    "mutationClass": {
      "enum": [
        "delete_effect",
        "add_effect",
        "suppress_audit",
        "duplicate_audit",
        "swap_correlation",
        "move_fault_before_barrier",
        "move_fault_after_barrier",
        "replace_evidence_producer",
        "corrupt_evidence_byte",
        "corrupt_declared_digest",
        "omit_probe",
        "producer_false_pass"
      ]
    },
    "integrityChecks": {
      "description": "Independent-verifier results for invariants that require comparing keys and references across arbitrary arrays. Qualified results require all three verified.",
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_id_uniqueness", "referential_closure", "evidence_trial_run_nonce_correlation"],
      "properties": {
        "semantic_id_uniqueness": { "enum": ["verified", "failed"] },
        "referential_closure": { "enum": ["verified", "failed"] },
        "evidence_trial_run_nonce_correlation": { "enum": ["verified", "failed"] }
      }
    },
    "mutationCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_id", "mutation_class", "applicable_predicate_ids", "outcome"],
      "properties": {
        "mutation_id": { "$ref": "#/$defs/boundedIdentity" },
        "mutation_class": { "$ref": "#/$defs/mutationClass" },
        "applicable_predicate_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/boundedIdentity" }
        },
        "outcome": { "enum": ["detected", "not_detected"] }
      }
    },
    "summary": {
      "description": "The independent verifier must recompute exact array lengths and category counts, enforce predicate_count = predicate_results.length, mutation_count = mutation_coverage.length, and enforce each satisfied/not-satisfied and detected/not-detected partition sum. JSON Schema enforces ranges and terminal zero/nonzero implications only; it cannot compare arbitrary sibling values or array lengths.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate_count",
        "satisfied_count",
        "not_satisfied_count",
        "mutation_count",
        "detected_mutation_count",
        "not_detected_mutation_count"
      ],
      "properties": {
        "predicate_count": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "satisfied_count": { "type": "integer", "minimum": 0, "maximum": 2048 },
        "not_satisfied_count": { "type": "integer", "minimum": 0, "maximum": 2048 },
        "mutation_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "detected_mutation_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "not_detected_mutation_count": { "type": "integer", "minimum": 0, "maximum": 4096 }
      }
    },
    "verifierAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "process_identity", "key_id", "algorithm", "qualification_sha256", "signature"],
      "properties": {
        "principal_id": { "$ref": "#/$defs/boundedIdentity" },
        "process_identity": { "$ref": "#/$defs/boundedIdentity" },
        "key_id": { "$ref": "#/$defs/boundedIdentity" },
        "algorithm": { "const": "Ed25519" },
        "qualification_sha256": { "$ref": "#/$defs/sha256" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  }
}
