{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plane.so/schemas/agent-tooling/safety-v1.bundle.schema.json",
  "title": "Plane Agent Tooling Safety Bundle Manifest v1",
  "description": "Sole path, byte-length, and raw SHA-256 authority for safety-v1. The manifest excludes itself. The static validator additionally enforces path sorting, unique path keys, reference closure, and DAG acyclicity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "schema_version",
    "bundle_id",
    "digest_contract",
    "files",
    "dependencies",
    "entrypoints"
  ],
  "properties": {
    "$schema": { "const": "./safety-v1.bundle.schema.json" },
    "schema": { "const": "plane.agent.safety-bundle/v1" },
    "schema_version": { "const": 1 },
    "bundle_id": { "const": "plane-agent-tooling-safety-v1" },
    "digest_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "encoding", "bytes"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "encoding": { "const": "lowercase-hex" },
        "bytes": { "const": "raw-file-bytes" }
      }
    },
    "files": {
      "description": "All and only bundle files, sorted by path. The canonical fixtures/safety-v1.bundle.json manifest and fixtures/safety-v1.qualification-lock.json lock instance are excluded to prevent self-digest and cross-pin cycles; their schemas remain ordinary bundle files.",
      "type": "array",
      "minItems": 7,
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/file" }
    },
    "dependencies": {
      "description": "Unique direct dependency edges sorted by from then to. Every endpoint resolves to files; self edges and cycles are forbidden by the static validator.",
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static_validator", "live_qualifier", "control_qualifier"],
      "properties": {
        "static_validator": {
          "const": "verifiers/validate-safety-bundle.mjs"
        },
        "live_qualifier": {
          "const": "verifiers/verify-safety-trials.mjs"
        },
        "control_qualifier": {
          "const": "verifiers/qualify-safety-controls.mjs"
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,127}){0,15}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 127,
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+(?:;[ -~]{1,64})?$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "media_type", "byte_length", "sha256"],
      "properties": {
        "path": {
          "allOf": [
            { "$ref": "#/$defs/path" },
            {
              "not": {
                "enum": ["fixtures/safety-v1.bundle.json", "fixtures/safety-v1.qualification-lock.json"]
              }
            }
          ]
        },
        "kind": {
          "enum": [
            "fixture",
            "schema",
            "predicate-set",
            "prompt",
            "probe-program",
            "verifier-entrypoint",
            "verifier-operator",
            "catalog",
            "configuration",
            "execution-limits",
            "runtime-metadata",
            "adapter-metadata",
            "release-metadata"
          ]
        },
        "media_type": { "$ref": "#/$defs/mediaType" },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/path" },
        "to": { "$ref": "#/$defs/path" }
      }
    }
  }
}
