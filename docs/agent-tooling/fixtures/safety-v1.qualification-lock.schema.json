{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plane.so/schemas/agent-tooling/safety-v1.qualification-lock.schema.json",
  "title": "Plane Agent Tooling Safety Qualification Lock v1",
  "description": "Exact immutable inputs accepted by a safety-v1 qualification run. Secrets, mutable ranges, floating image tags, self digests, and approval signatures are excluded. The static validator additionally proves evidence-principal separation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "schema_version",
    "lock_id",
    "repositories",
    "builds",
    "configurations",
    "manifests",
    "catalog",
    "runtime",
    "provider",
    "model",
    "accepted_evidence_sources"
  ],
  "properties": {
    "$schema": { "const": "./safety-v1.qualification-lock.schema.json" },
    "schema": { "const": "plane.agent.safety-qualification-lock/v1" },
    "schema_version": { "const": 1 },
    "lock_id": { "$ref": "#/$defs/identifier" },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plane", "hermes", "official_mcp", "plane_python_sdk"],
      "properties": {
        "plane": { "$ref": "#/$defs/repository" },
        "hermes": { "$ref": "#/$defs/repository" },
        "official_mcp": { "$ref": "#/$defs/repository" },
        "plane_python_sdk": { "$ref": "#/$defs/repository" }
      }
    },
    "builds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plane",
        "hermes",
        "official_mcp",
        "plane_python_sdk",
        "gateway_adapter",
        "hermes_host_adapter",
        "deno_supervisor",
        "model_isolate",
        "qualification_verifier",
        "qualification_container"
      ],
      "properties": {
        "plane": { "$ref": "#/$defs/build" },
        "hermes": { "$ref": "#/$defs/build" },
        "official_mcp": { "$ref": "#/$defs/build" },
        "plane_python_sdk": { "$ref": "#/$defs/build" },
        "gateway_adapter": { "$ref": "#/$defs/build" },
        "hermes_host_adapter": { "$ref": "#/$defs/build" },
        "deno_supervisor": { "$ref": "#/$defs/build" },
        "model_isolate": { "$ref": "#/$defs/build" },
        "qualification_verifier": { "$ref": "#/$defs/build" },
        "qualification_container": { "$ref": "#/$defs/build" }
      }
    },
    "configurations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plane",
        "hermes",
        "gateway",
        "qualification",
        "execution_limits",
        "sampling_reasoning",
        "isolate_policy"
      ],
      "properties": {
        "plane": { "$ref": "#/$defs/contentPin" },
        "hermes": { "$ref": "#/$defs/contentPin" },
        "gateway": { "$ref": "#/$defs/contentPin" },
        "qualification": { "$ref": "#/$defs/contentPin" },
        "execution_limits": { "$ref": "#/$defs/contentPin" },
        "sampling_reasoning": { "$ref": "#/$defs/contentPin" },
        "isolate_policy": { "$ref": "#/$defs/contentPin" }
      }
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "verification", "requirement_coverage", "evaluation_scenarios", "safety_bundle"],
      "properties": {
        "release": { "$ref": "#/$defs/versionedContentPin" },
        "verification": { "$ref": "#/$defs/versionedContentPin" },
        "requirement_coverage": { "$ref": "#/$defs/versionedContentPin" },
        "evaluation_scenarios": { "$ref": "#/$defs/versionedContentPin" },
        "safety_bundle": { "$ref": "#/$defs/versionedContentPin" }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "version", "content"],
      "properties": {
        "catalog_id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "content": { "$ref": "#/$defs/contentPin" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deno_version", "deno_binary", "isolate_runtime", "container_image", "platform"],
      "properties": {
        "deno_version": { "$ref": "#/$defs/version" },
        "deno_binary": { "$ref": "#/$defs/contentPin" },
        "isolate_runtime": { "$ref": "#/$defs/contentPin" },
        "container_image": { "$ref": "#/$defs/imagePin" },
        "platform": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+/[a-z0-9_]+$"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "endpoint", "adapter_version", "adapter_build"],
      "properties": {
        "id": { "const": "openai-codex" },
        "endpoint": { "$ref": "#/$defs/httpsUrl" },
        "adapter_version": { "$ref": "#/$defs/version" },
        "adapter_build": { "$ref": "#/$defs/contentPin" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metadata_fingerprint", "system_prompt", "acceptance_prompt", "tool_schemas"],
      "properties": {
        "id": { "const": "gpt-5.6-luna" },
        "metadata_fingerprint": { "$ref": "#/$defs/sha256" },
        "system_prompt": { "$ref": "#/$defs/contentPin" },
        "acceptance_prompt": { "$ref": "#/$defs/contentPin" },
        "tool_schemas": { "$ref": "#/$defs/contentPin" }
      }
    },
    "accepted_evidence_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plane_readback",
        "fault_harness",
        "network_canary",
        "container_supervisor",
        "hermes_trace",
        "trusted_host",
        "transport_harness",
        "independent_verifier"
      ],
      "properties": {
        "plane_readback": {
          "$ref": "#/$defs/planeReadbackSource"
        },
        "fault_harness": {
          "$ref": "#/$defs/faultHarnessSource"
        },
        "network_canary": {
          "$ref": "#/$defs/networkCanarySource"
        },
        "container_supervisor": {
          "$ref": "#/$defs/containerSupervisorSource"
        },
        "hermes_trace": {
          "$ref": "#/$defs/hermesTraceSource"
        },
        "trusted_host": {
          "$ref": "#/$defs/trustedHostSource"
        },
        "transport_harness": {
          "$ref": "#/$defs/transportHarnessSource"
        },
        "independent_verifier": {
          "$ref": "#/$defs/independentVerifierSource"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "description": "Credential-free immutable HTTPS location. URL userinfo, query strings, and fragments are forbidden.",
      "pattern": "^https://(?![^/?#]*@)[^\\s/?#]+(?:/[^\\s?#]*)?$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "commit", "tree_sha256"],
      "properties": {
        "remote": { "$ref": "#/$defs/httpsUrl" },
        "commit": { "$ref": "#/$defs/gitCommit" },
        "tree_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "contentPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_length", "sha256"],
      "properties": {
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "versionedContentPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "byte_length", "sha256"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_id", "artifact_sha256", "artifact_byte_length"],
      "properties": {
        "build_id": { "$ref": "#/$defs/identifier" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        }
      }
    },
    "imagePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "repository", "manifest_sha256"],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9][a-z0-9.-]*(?::[0-9]{1,5})?$"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
        },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceSourceBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_role",
        "producer_principal",
        "producer_process_identity",
        "producer_key_id",
        "attestation_algorithm",
        "source_channel_id",
        "source_channel_kind",
        "expected_peer_identity"
      ],
      "properties": {
        "producer_role": { "type": "string" },
        "producer_principal": { "$ref": "#/$defs/identity" },
        "producer_process_identity": { "$ref": "#/$defs/identity" },
        "producer_key_id": { "$ref": "#/$defs/identity" },
        "attestation_algorithm": { "const": "Ed25519" },
        "source_channel_id": { "$ref": "#/$defs/identity" },
        "source_channel_kind": {
          "enum": [
            "unix_peer_credentials",
            "mutual_tls",
            "pinned_service_identity",
            "signed_supervisor_channel",
            "authenticated_artifact_api"
          ]
        },
        "expected_peer_identity": { "$ref": "#/$defs/identity" }
      }
    },
    "planeReadbackSource": {
      "allOf": [
        { "$ref": "#/$defs/evidenceSourceBase" },
        {
          "type": "object",
          "properties": {
            "producer_role": { "const": "independent_plane_readback_verifier" },
            "source_channel_kind": { "const": "mutual_tls" }
          }
        }
      ]
    },
    "faultHarnessSource": {
      "allOf": [
        { "$ref": "#/$defs/evidenceSourceBase" },
        {
          "type": "object",
          "properties": {
            "producer_role": { "const": "fault_harness" },
            "source_channel_kind": { "const": "pinned_service_identity" }
          }
        }
      ]
    },
    "networkCanarySource": {
      "allOf": [
        { "$ref": "#/$defs/evidenceSourceBase" },
        {
          "type": "object",
          "properties": {
            "producer_role": { "const": "network_canary" },
            "source_channel_kind": { "const": "mutual_tls" }
          }
        }
      ]
    },
    "containerSupervisorSource": {
      "allOf": [
        { "$ref": "#/$defs/evidenceSourceBase" },
        {
          "type": "object",
          "properties": {
            "producer_role": { "const": "container_supervisor" },
            "source_channel_kind": { "const": "signed_supervisor_channel" }
          }
        }
      ]
    },
    "hermesTraceSource": {
      "allOf": [
        { "$ref": "#/$defs/evidenceSourceBase" },
        {
          "type": "object",
          "properties": {
            "producer_role": { "const": "hermes_trace_collector" },
            "source_channel_kind": { "const": "unix_peer_credentials" }
          }
        }
      ]
    },
    "trustedHostSource": {
      "allOf": [
        { "$ref": "#/$defs/evidenceSourceBase" },
        {
          "type": "object",
          "properties": {
            "producer_role": { "const": "trusted_host" },
            "source_channel_kind": { "const": "authenticated_artifact_api" }
          }
        }
      ]
    },
    "transportHarnessSource": {
      "allOf": [
        { "$ref": "#/$defs/evidenceSourceBase" },
        {
          "type": "object",
          "properties": {
            "producer_role": { "const": "transport_harness" },
            "source_channel_kind": { "const": "pinned_service_identity" }
          }
        }
      ]
    },
    "independentVerifierSource": {
      "allOf": [
        { "$ref": "#/$defs/evidenceSourceBase" },
        {
          "type": "object",
          "properties": {
            "producer_role": { "const": "independent_final_verifier" },
            "source_channel_kind": { "const": "authenticated_artifact_api" }
          }
        }
      ]
    }
  }
}
