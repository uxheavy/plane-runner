{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plane.so/schemas/agent-tooling/safety-v1.mutations.schema.json",
  "title": "Plane safety verifier mutation class and case catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "catalog_id",
    "qualification_status",
    "implementation_contract",
    "classes",
    "cases"
  ],
  "properties": {
    "$schema": {
      "const": "./safety-v1.mutations.schema.json"
    },
    "schema": {
      "const": "plane.agent.safety-mutation-catalog/v1"
    },
    "catalog_id": {
      "const": "plane-agent-safety-mutations-v1"
    },
    "qualification_status": {
      "enum": ["candidate_unimplemented", "qualifying_implemented"]
    },
    "classes": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mutationClassRecord"
      },
      "allOf": [
        {
          "contains": {
            "$ref": "#/$defs/deleteEffect"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/addEffect"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/suppressAudit"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/duplicateAudit"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/swapCorrelation"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/moveFaultBefore"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/moveFaultAfter"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/replaceProducer"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/corruptByte"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/corruptDigest"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/omitProbe"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/falsePass"
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "cases": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mutationCase"
      }
    },
    "implementation_contract": {
      "const": {
        "qualifying_case_set": "exact_12_canonical_ids_one_per_class",
        "module_resolution": "class_bound_verifiers_mutations_module",
        "digest_policy": "qualifying_cases_require_real_sha256",
        "selection_policy": "closed_RFC8785_canonical_first_applicable"
      }
    }
  },
  "$defs": {
    "stage": {
      "enum": [
        "normalized_application_delta",
        "normalized_gateway_audit",
        "authenticated_evidence_index",
        "verified_fault_schedule",
        "acquired_evidence_bytes",
        "normalized_probe_trace",
        "signed_producer_result"
      ]
    },
    "owner": {
      "const": "independent_verifier"
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "properties": {
        "class": {
          "type": "string"
        },
        "target_stage": {
          "$ref": "#/$defs/stage"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "type": "string"
        }
      }
    },
    "deleteEffect": {
      "type": "object",
      "properties": {
        "class": {
          "const": "delete_effect"
        },
        "target_stage": {
          "const": "normalized_application_delta"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "const": "remove_one_declared_effect"
        }
      },
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "additionalProperties": false
    },
    "addEffect": {
      "type": "object",
      "properties": {
        "class": {
          "const": "add_effect"
        },
        "target_stage": {
          "const": "normalized_application_delta"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "const": "duplicate_one_declared_effect"
        }
      },
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "additionalProperties": false
    },
    "suppressAudit": {
      "type": "object",
      "properties": {
        "class": {
          "const": "suppress_audit"
        },
        "target_stage": {
          "const": "normalized_gateway_audit"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "const": "remove_one_audit_record"
        }
      },
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "additionalProperties": false
    },
    "duplicateAudit": {
      "type": "object",
      "properties": {
        "class": {
          "const": "duplicate_audit"
        },
        "target_stage": {
          "const": "normalized_gateway_audit"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "const": "duplicate_one_audit_record"
        }
      },
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "additionalProperties": false
    },
    "swapCorrelation": {
      "type": "object",
      "properties": {
        "class": {
          "const": "swap_correlation"
        },
        "target_stage": {
          "const": "authenticated_evidence_index"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "const": "swap_run_binding_between_two_records"
        }
      },
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "additionalProperties": false
    },
    "moveFaultBefore": {
      "type": "object",
      "properties": {
        "class": {
          "const": "move_fault_before_barrier"
        },
        "target_stage": {
          "const": "verified_fault_schedule"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "const": "move_fault_to_immediately_preceding_barrier"
        }
      },
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "additionalProperties": false
    },
    "moveFaultAfter": {
      "type": "object",
      "properties": {
        "class": {
          "const": "move_fault_after_barrier"
        },
        "target_stage": {
          "const": "verified_fault_schedule"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "const": "move_fault_to_immediately_following_barrier"
        }
      },
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "additionalProperties": false
    },
    "replaceProducer": {
      "type": "object",
      "properties": {
        "class": {
          "const": "replace_evidence_producer"
        },
        "target_stage": {
          "const": "authenticated_evidence_index"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "const": "replace_attested_producer_with_wrong_class_control"
        }
      },
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "additionalProperties": false
    },
    "corruptByte": {
      "type": "object",
      "properties": {
        "class": {
          "const": "corrupt_evidence_byte"
        },
        "target_stage": {
          "const": "acquired_evidence_bytes"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "const": "xor_first_byte_with_0x01"
        }
      },
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "additionalProperties": false
    },
    "corruptDigest": {
      "type": "object",
      "properties": {
        "class": {
          "const": "corrupt_declared_digest"
        },
        "target_stage": {
          "const": "authenticated_evidence_index"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "const": "flip_low_bit_of_declared_sha256"
        }
      },
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "additionalProperties": false
    },
    "omitProbe": {
      "type": "object",
      "properties": {
        "class": {
          "const": "omit_probe"
        },
        "target_stage": {
          "const": "normalized_probe_trace"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "const": "remove_one_required_probe_record"
        }
      },
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "additionalProperties": false
    },
    "falsePass": {
      "type": "object",
      "properties": {
        "class": {
          "const": "producer_false_pass"
        },
        "target_stage": {
          "const": "signed_producer_result"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "transformation_kind": {
          "const": "replace_failed_outcome_with_passed"
        }
      },
      "required": ["class", "target_stage", "owner", "transformation_kind"],
      "additionalProperties": false
    },
    "mutationClassRecord": {
      "oneOf": [
        {
          "$ref": "#/$defs/deleteEffect"
        },
        {
          "$ref": "#/$defs/addEffect"
        },
        {
          "$ref": "#/$defs/suppressAudit"
        },
        {
          "$ref": "#/$defs/duplicateAudit"
        },
        {
          "$ref": "#/$defs/swapCorrelation"
        },
        {
          "$ref": "#/$defs/moveFaultBefore"
        },
        {
          "$ref": "#/$defs/moveFaultAfter"
        },
        {
          "$ref": "#/$defs/replaceProducer"
        },
        {
          "$ref": "#/$defs/corruptByte"
        },
        {
          "$ref": "#/$defs/corruptDigest"
        },
        {
          "$ref": "#/$defs/omitProbe"
        },
        {
          "$ref": "#/$defs/falsePass"
        }
      ]
    },
    "mutationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "module_path", "module_sha256", "selection"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
          "maxLength": 96
        },
        "class": {
          "enum": [
            "delete_effect",
            "add_effect",
            "suppress_audit",
            "duplicate_audit",
            "swap_correlation",
            "move_fault_before_barrier",
            "move_fault_after_barrier",
            "replace_evidence_producer",
            "corrupt_evidence_byte",
            "corrupt_declared_digest",
            "omit_probe",
            "producer_false_pass"
          ]
        },
        "module_path": {
          "enum": [
            "verifiers/mutations/delete-effect.mjs",
            "verifiers/mutations/add-effect.mjs",
            "verifiers/mutations/suppress-audit.mjs",
            "verifiers/mutations/duplicate-audit.mjs",
            "verifiers/mutations/swap-correlation.mjs",
            "verifiers/mutations/move-fault-before-barrier.mjs",
            "verifiers/mutations/move-fault-after-barrier.mjs",
            "verifiers/mutations/replace-evidence-producer.mjs",
            "verifiers/mutations/corrupt-evidence-byte.mjs",
            "verifiers/mutations/corrupt-declared-digest.mjs",
            "verifiers/mutations/omit-probe.mjs",
            "verifiers/mutations/producer-false-pass.mjs"
          ]
        },
        "module_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "selection": {
          "$ref": "#/$defs/canonicalSelection"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "class": {
                "const": "delete_effect"
              }
            },
            "required": ["class"]
          },
          "then": {
            "type": "object",
            "properties": {
              "module_path": {
                "const": "verifiers/mutations/delete-effect.mjs"
              },
              "selection": {
                "properties": {
                  "selector": {
                    "const": "first_applicable_record"
                  }
                },
                "required": ["selector"],
                "type": "object"
              }
            },
            "required": ["module_path", "selection"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "class": {
                "const": "add_effect"
              }
            },
            "required": ["class"]
          },
          "then": {
            "type": "object",
            "properties": {
              "module_path": {
                "const": "verifiers/mutations/add-effect.mjs"
              },
              "selection": {
                "properties": {
                  "selector": {
                    "const": "first_applicable_record"
                  }
                },
                "required": ["selector"],
                "type": "object"
              }
            },
            "required": ["module_path", "selection"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "class": {
                "const": "suppress_audit"
              }
            },
            "required": ["class"]
          },
          "then": {
            "type": "object",
            "properties": {
              "module_path": {
                "const": "verifiers/mutations/suppress-audit.mjs"
              },
              "selection": {
                "properties": {
                  "selector": {
                    "const": "first_applicable_record"
                  }
                },
                "required": ["selector"],
                "type": "object"
              }
            },
            "required": ["module_path", "selection"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "class": {
                "const": "duplicate_audit"
              }
            },
            "required": ["class"]
          },
          "then": {
            "type": "object",
            "properties": {
              "module_path": {
                "const": "verifiers/mutations/duplicate-audit.mjs"
              },
              "selection": {
                "properties": {
                  "selector": {
                    "const": "first_applicable_record"
                  }
                },
                "required": ["selector"],
                "type": "object"
              }
            },
            "required": ["module_path", "selection"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "class": {
                "const": "swap_correlation"
              }
            },
            "required": ["class"]
          },
          "then": {
            "type": "object",
            "properties": {
              "module_path": {
                "const": "verifiers/mutations/swap-correlation.mjs"
              },
              "selection": {
                "properties": {
                  "selector": {
                    "const": "first_two_applicable_records"
                  }
                },
                "required": ["selector"],
                "type": "object"
              }
            },
            "required": ["module_path", "selection"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "class": {
                "const": "move_fault_before_barrier"
              }
            },
            "required": ["class"]
          },
          "then": {
            "type": "object",
            "properties": {
              "module_path": {
                "const": "verifiers/mutations/move-fault-before-barrier.mjs"
              },
              "selection": {
                "properties": {
                  "selector": {
                    "const": "first_applicable_record"
                  }
                },
                "required": ["selector"],
                "type": "object"
              }
            },
            "required": ["module_path", "selection"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "class": {
                "const": "move_fault_after_barrier"
              }
            },
            "required": ["class"]
          },
          "then": {
            "type": "object",
            "properties": {
              "module_path": {
                "const": "verifiers/mutations/move-fault-after-barrier.mjs"
              },
              "selection": {
                "properties": {
                  "selector": {
                    "const": "first_applicable_record"
                  }
                },
                "required": ["selector"],
                "type": "object"
              }
            },
            "required": ["module_path", "selection"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "class": {
                "const": "replace_evidence_producer"
              }
            },
            "required": ["class"]
          },
          "then": {
            "type": "object",
            "properties": {
              "module_path": {
                "const": "verifiers/mutations/replace-evidence-producer.mjs"
              },
              "selection": {
                "properties": {
                  "selector": {
                    "const": "first_applicable_record"
                  }
                },
                "required": ["selector"],
                "type": "object"
              }
            },
            "required": ["module_path", "selection"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "class": {
                "const": "corrupt_evidence_byte"
              }
            },
            "required": ["class"]
          },
          "then": {
            "type": "object",
            "properties": {
              "module_path": {
                "const": "verifiers/mutations/corrupt-evidence-byte.mjs"
              },
              "selection": {
                "properties": {
                  "selector": {
                    "const": "first_applicable_record"
                  }
                },
                "required": ["selector"],
                "type": "object"
              }
            },
            "required": ["module_path", "selection"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "class": {
                "const": "corrupt_declared_digest"
              }
            },
            "required": ["class"]
          },
          "then": {
            "type": "object",
            "properties": {
              "module_path": {
                "const": "verifiers/mutations/corrupt-declared-digest.mjs"
              },
              "selection": {
                "properties": {
                  "selector": {
                    "const": "first_applicable_record"
                  }
                },
                "required": ["selector"],
                "type": "object"
              }
            },
            "required": ["module_path", "selection"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "class": {
                "const": "omit_probe"
              }
            },
            "required": ["class"]
          },
          "then": {
            "type": "object",
            "properties": {
              "module_path": {
                "const": "verifiers/mutations/omit-probe.mjs"
              },
              "selection": {
                "properties": {
                  "selector": {
                    "const": "first_applicable_record"
                  }
                },
                "required": ["selector"],
                "type": "object"
              }
            },
            "required": ["module_path", "selection"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "class": {
                "const": "producer_false_pass"
              }
            },
            "required": ["class"]
          },
          "then": {
            "type": "object",
            "properties": {
              "module_path": {
                "const": "verifiers/mutations/producer-false-pass.mjs"
              },
              "selection": {
                "properties": {
                  "selector": {
                    "const": "first_applicable_record"
                  }
                },
                "required": ["selector"],
                "type": "object"
              }
            },
            "required": ["module_path", "selection"]
          }
        }
      ]
    },
    "canonicalSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordering", "selector"],
      "properties": {
        "ordering": {
          "const": "RFC8785_lexicographic_record_identity"
        },
        "selector": {
          "enum": ["first_applicable_record", "first_two_applicable_records"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "qualification_status": {
            "const": "candidate_unimplemented"
          }
        },
        "required": ["qualification_status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "cases": {
            "type": "array",
            "maxItems": 0
          }
        },
        "required": ["cases"]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "qualification_status": {
            "const": "qualifying_implemented"
          }
        },
        "required": ["qualification_status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "cases": {
            "type": "array",
            "minItems": 12,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "M-EFFECT-DELETE"
                    },
                    "class": {
                      "const": "delete_effect"
                    }
                  },
                  "required": ["id", "class"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "M-EFFECT-ADD"
                    },
                    "class": {
                      "const": "add_effect"
                    }
                  },
                  "required": ["id", "class"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "M-AUDIT-SUPPRESS"
                    },
                    "class": {
                      "const": "suppress_audit"
                    }
                  },
                  "required": ["id", "class"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "M-AUDIT-DUPLICATE"
                    },
                    "class": {
                      "const": "duplicate_audit"
                    }
                  },
                  "required": ["id", "class"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "M-CORRELATION-SWAP"
                    },
                    "class": {
                      "const": "swap_correlation"
                    }
                  },
                  "required": ["id", "class"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "M-FAULT-BEFORE-BARRIER"
                    },
                    "class": {
                      "const": "move_fault_before_barrier"
                    }
                  },
