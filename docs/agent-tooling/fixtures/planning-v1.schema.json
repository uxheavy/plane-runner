{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plane.so/schemas/agent-tooling/planning-v1.schema.json",
  "title": "Plane Agent Tooling Planning Fixture Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "schema_version",
    "fixture_set_id",
    "seed_clock",
    "symbolic_identity_rule",
    "impact_scoring",
    "shared",
    "fixtures",
    "common_expected"
  ],
  "properties": {
    "$schema": { "const": "./planning-v1.schema.json" },
    "schema": { "const": "plane.agent.fixture-set/v1" },
    "schema_version": { "const": 1 },
    "fixture_set_id": { "const": "plane-agent-tooling-planning-v1" },
    "seed_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "timezone", "date_encoding"],
      "properties": {
        "mode": { "const": "recorded_epoch" },
        "timezone": { "const": "UTC" },
        "date_encoding": { "type": "string", "minLength": 1 }
      }
    },
    "symbolic_identity_rule": { "type": "string", "minLength": 1 },
    "impact_scoring": { "$ref": "#/$defs/impactScoring" },
    "shared": { "$ref": "#/$defs/shared" },
    "fixtures": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/fixture" }
    },
    "common_expected": { "$ref": "#/$defs/commonExpected" }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "priority": { "enum": ["urgent", "high", "medium", "low", "none"] },
    "role": { "enum": ["guest", "member", "admin"] },
    "stateGroup": { "enum": ["triage", "backlog", "unstarted", "started", "completed", "cancelled"] },
    "stringArray": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "countTriple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parents", "children", "comments"],
      "properties": {
        "parents": { "type": "integer", "minimum": 0 },
        "children": { "type": "integer", "minimum": 0 },
        "comments": { "type": "integer", "minimum": 0 }
      }
    },
    "impactScoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_state_groups",
        "generated_artifacts_are_ineligible",
        "generated_artifact_name_pattern",
        "priority_points",
        "direct_dependent_points_each",
        "direct_dependent_cap",
        "unassigned_points",
        "started_points",
        "target_overdue_points",
        "target_within_three_days_points",
        "ineligible_state_score",
        "tie_break",
        "selection"
      ],
      "properties": {
        "eligible_state_groups": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["backlog", "unstarted", "started"] }
        },
        "generated_artifacts_are_ineligible": { "const": true },
        "generated_artifact_name_pattern": {
          "const": "^\\[run:[A-Za-z0-9][A-Za-z0-9._-]{0,63}\\] "
        },
        "priority_points": {
          "type": "object",
          "additionalProperties": false,
          "required": ["urgent", "high", "medium", "low", "none"],
          "properties": {
            "urgent": { "type": "integer" },
            "high": { "type": "integer" },
            "medium": { "type": "integer" },
            "low": { "type": "integer" },
            "none": { "type": "integer" }
          }
        },
        "direct_dependent_points_each": { "type": "integer", "minimum": 0 },
        "direct_dependent_cap": { "type": "integer", "minimum": 0 },
        "unassigned_points": { "type": "integer", "minimum": 0 },
        "started_points": { "type": "integer", "minimum": 0 },
        "target_overdue_points": { "type": "integer", "minimum": 0 },
        "target_within_three_days_points": { "type": "integer", "minimum": 0 },
        "ineligible_state_score": { "type": "integer", "maximum": -1 },
        "tie_break": { "type": "string", "minLength": 1 },
        "selection": { "type": "string", "minLength": 1 }
      }
    },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "target_project_defaults", "states", "labels", "members", "control_project"],
      "properties": {
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slug_template", "agent_is_active_workspace_member"],
          "properties": {
            "slug_template": { "type": "string", "minLength": 1 },
            "agent_is_active_workspace_member": { "const": true }
          }
        },
        "target_project_defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["network", "cycle_enabled", "agent_membership"],
          "properties": {
            "network": { "const": 0 },
            "cycle_enabled": { "const": true },
            "agent_membership": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "active"],
              "properties": {
                "role": { "const": "member" },
                "active": { "const": true }
              }
            }
          }
        },
        "states": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/state" }
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/label" }
        },
        "members": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/member" }
        },
        "control_project": { "$ref": "#/$defs/controlProject" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "group"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1 },
        "group": { "$ref": "#/$defs/stateGroup" }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "display_name", "role", "user_active", "project_member_active", "bot"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "display_name": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/role" },
        "user_active": { "type": "boolean" },
        "project_member_active": { "type": "boolean" },
        "bot": { "type": "boolean" }
      }
    },
    "controlProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "identifier",
        "name",
        "network",
        "cycle_enabled",
        "agent_membership",
        "seed_actor",
        "members",
        "marker",
        "work_items"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "identifier": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,8}$" },
        "name": { "type": "string", "minLength": 1 },
        "network": { "const": 0 },
        "cycle_enabled": { "const": true },
        "agent_membership": { "const": "none" },
        "seed_actor": { "const": "admin" },
        "members": { "type": "array", "const": ["admin"] },
        "marker": { "type": "string", "minLength": 1 },
        "work_items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workItem" }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "name"],
      "properties": {
        "identifier": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,8}$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "start_offset_days", "end_offset_days"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1 },
        "start_offset_days": { "type": "integer" },
        "end_offset_days": { "type": "integer" }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "priority", "state", "assignees"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "priority": { "$ref": "#/$defs/priority" },
        "state": { "$ref": "#/$defs/key" },
        "assignees": { "$ref": "#/$defs/stringArray" },
        "labels": { "$ref": "#/$defs/stringArray" },
        "cycle": { "$ref": "#/$defs/key" },
        "parent": { "$ref": "#/$defs/key" },
        "target_offset_days": { "type": "integer" },
        "source_work_item": { "$ref": "#/$defs/key" },
        "generated_artifact": { "type": "boolean" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "from", "type", "to"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "from": { "$ref": "#/$defs/key" },
        "type": {
          "enum": [
            "blocked_by",
            "blocking",
            "duplicate",
            "relates_to",
            "start_before",
            "start_after",
            "finish_before",
            "finish_after"
          ]
        },
        "to": { "$ref": "#/$defs/key" }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "work_item", "comment_html", "generated_artifact"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "work_item": { "$ref": "#/$defs/key" },
        "comment_html": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "pattern": "^https://" },
        "generated_artifact": { "const": true }
      }
    },
    "moduloValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modulus", "values"],
      "properties": {
        "modulus": { "type": "integer", "minimum": 1 },
        "values": { "type": "array", "minItems": 1 }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "index_start",
        "count",
        "key_template",
        "name_template",
        "priority_by_modulo",
        "state_by_modulo",
        "assignee_by_modulo",
        "cycle",
        "target_offset"
      ],
      "properties": {
        "generator": { "const": "indexed-work-items/v1" },
        "index_start": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 1 },
        "key_template": { "type": "string", "minLength": 1 },
        "name_template": { "type": "string", "minLength": 1 },
        "priority_by_modulo": { "$ref": "#/$defs/moduloValues" },
        "state_by_modulo": { "$ref": "#/$defs/moduloValues" },
        "assignee_by_modulo": { "$ref": "#/$defs/moduloValues" },
        "cycle": { "$ref": "#/$defs/key" },
        "target_offset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "modulus", "add"],
          "properties": {
            "operation": { "const": "modulo_plus" },
            "modulus": { "type": "integer", "minimum": 1 },
            "add": { "type": "integer" }
          }
        }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "priority": { "$ref": "#/$defs/priority" },
        "state": { "$ref": "#/$defs/key" },
        "assignees": { "$ref": "#/$defs/stringArray" },
        "target_offset_days": { "type": "integer" },
        "labels": { "$ref": "#/$defs/stringArray" }
      }
    },
    "priorInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "seed_method",
        "actor_key",
        "workspace_binding",
        "operation_id",
        "catalog_digest_binding",
        "trusted_idempotency_binding",
        "run_tag",
        "source_url",
        "canonical_input_digest",
        "recorded_result_object_keys"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "seed_method": { "const": "execute_semantic_operation" },
        "actor_key": { "const": "agent" },
        "workspace_binding": { "const": "fixture_workspace" },
        "operation_id": { "const": "plane.release_plans.create@1" },
        "catalog_digest_binding": { "const": "approved_catalog_digest" },
        "trusted_idempotency_binding": { "type": "string", "minLength": 1 },
        "run_tag": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "source_url": { "type": "string", "pattern": "^https://" },
        "canonical_input_digest": { "const": "captured_from_real_seed_operation" },
        "recorded_result_object_keys": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["plan_created", "prewrite_error"] },
        "selected_source_keys": { "$ref": "#/$defs/stringArray" },
        "forbidden_inventions": { "$ref": "#/$defs/stringArray" },
        "error_code": { "enum": ["not_found", "ambiguous_reference"] },
        "error_reason": { "enum": ["current_cycle_missing", "multiple_current_cycles"] },
        "created_counts": { "$ref": "#/$defs/countTriple" },
        "authorized_candidate_cycle_keys": { "$ref": "#/$defs/stringArray" },
        "required_dependency_order": { "$ref": "#/$defs/stringArray" },
        "relation_cycle_components": {
          "type": "array",
          "items": { "$ref": "#/$defs/stringArray" }
        },
        "forbidden_dependency_orders": {
          "type": "array",
          "items": { "$ref": "#/$defs/stringArray" }
        },
        "unrelated_relation_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/stringArray" }
        },
        "overloaded_member_keys": { "$ref": "#/$defs/stringArray" },
        "valid_new_assignee_keys": { "$ref": "#/$defs/stringArray" },
        "forbidden_assignee_keys": { "$ref": "#/$defs/stringArray" },
        "ineligible_source_keys": { "$ref": "#/$defs/stringArray" },
        "source_items_unchanged": { "type": "boolean" },
        "prior_artifact_counts_unchanged": { "$ref": "#/$defs/countTriple" },
        "new_artifact_counts": { "$ref": "#/$defs/countTriple" },
        "prior_invocation_replay_creates": { "const": 0 },
        "required_item_count_observed": { "type": "integer", "minimum": 1 },
        "pagination_request_page_size": { "const": 25 },
        "expected_page_count": { "const": 5 },
        "expected_non_null_continuation_count": { "const": 4 },
        "expected_terminal_cursor": { "type": "null" },
        "complete_cursor_chain": { "type": "boolean" },
        "required_source_keys_observed": { "$ref": "#/$defs/stringArray" },
        "no_silent_page_omission": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "required": ["outcome"], "properties": { "outcome": { "const": "plan_created" } } },
          "then": { "required": ["selected_source_keys"], "properties": { "selected_source_keys": true } }
        },
        {
          "if": { "required": ["outcome"], "properties": { "outcome": { "const": "prewrite_error" } } },
          "then": {
            "required": ["error_code", "error_reason", "created_counts"],
            "properties": { "error_code": true, "error_reason": true, "created_counts": true }
          }
        }
      ]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario_id", "project", "cycles", "members", "relations", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^FX-PLAN-0(0[1-9]|10)$" },
        "scenario_id": { "type": "string", "pattern": "^EV-0(0[1-9]|10)$" },
        "project": { "$ref": "#/$defs/project" },
        "cycles": { "type": "array", "items": { "$ref": "#/$defs/cycle" } },
        "members": { "$ref": "#/$defs/stringArray" },
        "work_items": { "type": "array", "items": { "$ref": "#/$defs/workItem" } },
        "work_item_generator": { "$ref": "#/$defs/generator" },
        "overrides": { "type": "array", "items": { "$ref": "#/$defs/override" } },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "comments": { "type": "array", "items": { "$ref": "#/$defs/comment" } },
        "prior_invocation": { "$ref": "#/$defs/priorInvocation" },
        "expected": { "$ref": "#/$defs/expected" }
      },
      "oneOf": [
        {
          "required": ["work_items"],
          "properties": { "work_items": true, "work_item_generator": false }
        },
        {
          "required": ["work_item_generator", "overrides"],
          "properties": { "work_item_generator": true, "overrides": true, "work_items": false }
        }
      ]
    },
    "commonExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_created_counts",
        "source_item_mutations",
        "control_project_leaks",
        "provider",
        "model",
        "fresh_hermes_process_per_trial",
        "independent_trials_per_fixture",
        "child_source_name_template",
        "source_url_template"
      ],
      "properties": {
        "plan_created_counts": { "$ref": "#/$defs/countTriple" },
        "source_item_mutations": { "const": 0 },
        "control_project_leaks": { "const": 0 },
        "provider": { "const": "openai-codex" },
        "model": { "const": "gpt-5.6-luna" },
        "fresh_hermes_process_per_trial": { "const": true },
        "independent_trials_per_fixture": { "const": 3 },
        "child_source_name_template": {
          "const": "[run:${RUN_TAG}] [source:${PROJECT_IDENTIFIER}-${SEQUENCE}] ${SUMMARY}"
        },
        "source_url_template": { "const": "https://fixtures.invalid/${fixture_id}/${trial}" }
      }
    }
  }
}
