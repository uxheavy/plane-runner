{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plane.so/schemas/agent-tooling/g0-readiness-v2.schema.json",
  "title": "Plane Agent Tooling G0 readiness record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "recordId",
    "status",
    "approval",
    "owners",
    "integrationLock",
    "evidenceDigests",
    "clauses",
    "preflightCommand",
    "normalVerificationCommand"
  ],
  "properties": {
    "$schema": { "const": "./g0-readiness.schema.json" },
    "schemaVersion": { "const": 2 },
    "recordId": { "const": "plane-agent-tooling-g0-readiness" },
    "status": { "enum": ["pending-human-approval", "approved"] },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "manifestPath", "manifestDigest", "statement"],
      "properties": {
        "status": { "enum": ["pending", "approved"] },
        "manifestPath": { "const": "docs/agent-tooling/APPROVAL-MANIFEST.md" },
        "manifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "statement": {
          "const": "I approve `APPROVAL-MANIFEST.md` as the controlling Plane Agent Tooling V1 scope and authorize implementation to begin. I understand that pilot and production remain separately gated."
        },
        "approvedBy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "reference"],
          "properties": {
            "identity": { "type": "string", "minLength": 1 },
            "reference": { "type": "string", "minLength": 1 }
          }
        },
        "approvedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "evidenceBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentCommit", "sealedHead", "lockDigest"],
          "properties": {
            "contentCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "sealedHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "lockDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerRole", "reviewerRole", "lockWriterRole", "approvalAuthority"],
      "properties": {
        "ownerRole": { "const": "root-integrator" },
        "reviewerRole": { "const": "sol-reviewer" },
        "lockWriterRole": { "const": "integration-lock-writer" },
        "approvalAuthority": { "const": "user-controlling-this-codex-task" }
      }
    },
    "integrationLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schemaPath", "lockId"],
      "properties": {
        "path": { "const": "docs/agent-tooling/integration-lock.g0.json" },
        "schemaPath": { "const": "docs/agent-tooling/integration-lock.schema.json" },
        "lockId": { "const": "plane-agent-tooling-g0" }
      }
    },
    "evidenceDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "ownerRole", "reviewerRole", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^G0-[A-Z0-9-]+$" },
          "status": { "enum": ["ready", "ready-pending-approval", "pending"] },
          "ownerRole": { "type": "string", "minLength": 1 },
          "reviewerRole": { "const": "sol-reviewer" },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "preflightCommand": { "const": "node docs/agent-tooling/verifiers/verify-g0-preflight.mjs --mode preflight" },
    "normalVerificationCommand": { "const": "node docs/agent-tooling/verifiers/verify-g0-preflight.mjs --mode g0" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pending-human-approval" } } },
      "then": {
        "properties": {
          "approval": {
            "type": "object",
            "properties": { "status": { "const": "pending" } }
          }
        },
        "not": {
          "properties": {
            "approval": {
              "anyOf": [
                { "type": "object", "properties": { "approvedBy": {} }, "required": ["approvedBy"] },
                { "type": "object", "properties": { "approvedAt": {} }, "required": ["approvedAt"] },
                { "type": "object", "properties": { "evidenceBinding": {} }, "required": ["evidenceBinding"] }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "properties": {
          "approval": {
            "type": "object",
            "required": ["approvedBy", "approvedAt", "evidenceBinding"],
            "properties": {
              "status": { "const": "approved" },
              "approvedBy": {},
              "approvedAt": {},
              "evidenceBinding": {}
            }
          }
        }
      }
    }
  ]
}
