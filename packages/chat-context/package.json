{
  "name": "@plane/chat-context",
  "version": "1.3.1",
  "private": true,
  "description": "Semantic Plane context selection and composer-safe contracts",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./html2canvas-pro": "./dist/html2canvas-pro.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "verify:bundle": "node scripts/verify-production-bundle.mjs",
    "check:lint": "oxlint --max-warnings=0 .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "html2canvas-pro": "catalog:",
    "react-grab": "catalog:"
  },
  "devDependencies": {
    "@plane/typescript-config": "workspace:*",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-collaboration": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yjs": "catalog:"
  }
}
